        <when condition="@((int)context.Variables["OpenAiPathIndex"] >= 0)">
        <set-variable name="X-ConditionCheck" value="OpenAi" />
        <set-backend-service backend-id="astaieus2-openai" />
        <rewrite-uri template="@((string)context.Request.Url.Path.Substring((int)context.Variables["OpenAiPathIndex"]))" />
        <set-query-parameter name="api-version" exists-action="override">
        <value>@(context.Request.Url.Query.GetValueOrDefault("api-version") ?? "2024-05-01-preview")</value>
        </set-query-parameter>
        </when>
        <otherwise>
        <set-variable name="X-ConditionCheck" value="Foundry" />
        <set-backend-service backend-id="astaieus2" />
        </otherwise>
