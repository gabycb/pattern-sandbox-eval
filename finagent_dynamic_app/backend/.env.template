# Azure AI (preferred) - AI Foundry project endpoint
AZURE_AI_PROJECT_ENDPOINT=https://your-project.api.azureml.ms
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o

# Azure OpenAI Configuration (legacy fallback)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Framework compatibility - use same deployment name
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o

# ============================================================================
# Azure API Management (APIM) AI Gateway Configuration
# ============================================================================
# Enable APIM to route all AI requests through API Management
APIM_ENABLED=false
APIM_GATEWAY_URL=https://your-apim-instance.azure-api.net/openai
APIM_SUBSCRIPTION_KEY=your-apim-subscription-key
APIM_SUBSCRIPTION_HEADER=Ocp-Apim-Subscription-Key

# Entra Agent ID Authentication (for secure agent identity)
# See: https://techcommunity.microsoft.com/blog/microsoft-entra-blog/announcing-microsoft-entra-agent-id-secure-and-manage-your-ai-agents/3827392
ENTRA_AGENT_ID_ENABLED=false
ENTRA_AGENT_TENANT_ID=your-tenant-id
ENTRA_AGENT_CLIENT_ID=your-agent-client-id
ENTRA_AGENT_CLIENT_SECRET=your-agent-client-secret
ENTRA_AGENT_SCOPE=https://cognitiveservices.azure.com/.default

# APIM Feature Flags
APIM_ENABLE_LOAD_BALANCING=true
APIM_ENABLE_RATE_LIMITING=true
APIM_ENABLE_CONTENT_FILTERING=true
APIM_ENABLE_TOKEN_TRACKING=true
APIM_ENABLE_CACHING=false

# APIM Monitoring
APIM_LOG_ANALYTICS_WORKSPACE_ID=your-workspace-id
APIM_APPLICATION_INSIGHTS_KEY=your-app-insights-key
APIM_DEBUG_MODE=false
APIM_LOG_REQUEST_BODY=false
APIM_LOG_RESPONSE_BODY=false
# ============================================================================

# Financial Data APIs
FMP_API_KEY=your-fmp-api-key
YAHOO_FINANCE_ENABLED=true

# SEC Data
SEC_API_KEY=optional-sec-api-key
SEC_USER_AGENT=your-company-name contact@example.com

# Azure Storage (for PDF reports)
AZURE_STORAGE_CONNECTION_STRING=your-connection-string
AZURE_STORAGE_CONTAINER=financial-reports

# Azure Cosmos DB (for state management)
COSMOS_DB_ENDPOINT=https://your-cosmos.documents.azure.com:443/
COSMOS_DB_KEY=your-cosmos-key
COSMOS_DB_DATABASE=finagent
COSMOS_DB_CONTAINER=sessions

# Application Insights (optional)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# MCP Server Configuration
MCP_ENABLED=true
MCP_SERVER_PORT=8100
# For production (Azure deployment), this will be set to the Container App URL:
# YAHOO_FINANCE_MCP_URL=https://<container-app-fqdn>/sse
YAHOO_FINANCE_MCP_URL=http://localhost:8001/sse

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Agent Configuration
MAX_CONCURRENT_AGENTS=5
DEFAULT_AGENT_TIMEOUT=300
ENABLE_AGENT_TELEMETRY=true

# Execution Configuration
MAX_SEQUENTIAL_STEPS=10
HANDOFF_MAX_ITERATIONS=10
GROUP_CHAT_MAX_TURNS=40
