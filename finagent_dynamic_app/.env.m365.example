# Microsoft 365 Agent configuration
# Copy this file to .env.m365 and provide environment specific secrets.

# Enable the Microsoft 365 agent experience.
ENABLE_M365_AGENT=true

# OAuth client used by the Microsoft 365 Agents SDK host.
M365_CLIENT_ID=<entra-app-client-id>
M365_CLIENT_SECRET=<entra-app-client-secret>
M365_TENANT_ID=<entra-tenant-id>

# Bot registration credentials provisioned by Agents Toolkit.
M365_BOT_ID=<bot-app-id>
M365_BOT_PASSWORD=<bot-password>

# Public base URL for the Agents host (for example, https://<domain>.ngrok-free.app).
# The host binds to this address when present; otherwise defaults to 0.0.0.0:3978.
M365_HOST_BASE_URL=https://localhost:3978

# Existing backend configuration required by the planner/runner services.
COSMOSDB_ENDPOINT=<cosmos-endpoint>
COSMOSDB_KEY=<cosmos-key>
COSMOS_DB_DATABASE=finagent
COSMOS_DB_CONTAINER=dynamic
AZURE_TENANT_ID=<azure-tenant-id>
AZURE_CLIENT_ID=<service-principal-client-id>
AZURE_CLIENT_SECRET=<service-principal-secret>
